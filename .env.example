# Copy this file to .env.local and fill in your own Supabase project values.
# Find both under Supabase Dashboard -> Settings -> API.
# Never commit .env.local: .gitignore excludes every .env* file except this one.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Same variable name as Raptor/Romulus, so the two apps can share one .env when merged.
# The anon key and the newer "publishable" key (sb_publishable_...) both work here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional alias, read only if VITE_SUPABASE_ANON_KEY is empty.
# VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------- Server-side only (Vercel functions in api/). Never prefix these with VITE_. ----------
# The functions verify the caller's Supabase session and then read data *as that user*
# (RLS applies), using VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY above. No service-role key needed.

# Optional. Enables AI slip reading + project/category suggestions (api/receipts/extract.ts).
# Leave empty and slip capture still works: the slip is uploaded and the form is filled in by hand.
ANTHROPIC_API_KEY=

# Optional. Enables "Send to client" on quotes (api/quotes/send.ts).
SMTP_HOST=smtp.example.co.za
SMTP_PORT=465
SMTP_USER=quotes@example.co.za
SMTP_PASS=
SMTP_FROM="Your Company <quotes@example.co.za>"
