# Copy this file to .env.local and fill in your own Supabase project values.
# Find both under Supabase Dashboard -> Settings -> API.
# Never commit .env.local: .gitignore excludes every .env* file except this one.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Same variable name as Raptor/Romulus, so the two apps can share one .env when merged.
# The anon key and the newer "publishable" key (sb_publishable_...) both work here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional alias, read only if VITE_SUPABASE_ANON_KEY is empty.
# VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------- Server-side only (Vercel functions in api/). Never prefix these with VITE_. ----------
# Most functions verify the caller's Supabase session and then read data *as that user*
# (RLS applies), using VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY above.

# Optional. Supabase Dashboard -> Settings -> API -> service_role (secret). Needed only for
# inviting people from Settings -> Team (api/team/invite.ts) and for the Claude connector
# (api/mcp.ts). Server-side only; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. The production address, used in invite links and connector links.
APP_URL=https://remus-xi.vercel.app

# Optional. Enables AI slip reading + project/category suggestions (api/receipts/extract.ts).
# Leave empty and slip capture still works: the slip is uploaded and the form is filled in by hand.
ANTHROPIC_API_KEY=

# Optional. Enables "Send to client" on quotes (api/quotes/send.ts), through Resend (preferred)...
RESEND_API_KEY=
EMAIL_FROM="Urban Haus Construction <quotes@urbanhausgroup.co.za>"
# ...or over SMTP, used only when RESEND_API_KEY is empty.
SMTP_HOST=smtp.example.co.za
SMTP_PORT=465
SMTP_USER=quotes@example.co.za
SMTP_PASS=
SMTP_FROM="Your Company <quotes@example.co.za>"

# For the daily client-email sync (Vercel Cron -> api/email/sync). Any long random string.
CRON_SECRET=
