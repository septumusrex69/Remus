{
  "regions": [
    "cdg1"
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|brand/|favicon\\.svg|manifest\\.webmanifest|sw\\.js|offline\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/email/sync",
      "schedule": "0 4 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
